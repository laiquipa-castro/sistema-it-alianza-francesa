# =============================================================================
# Configuración del BACKEND (FastAPI)
# -----------------------------------------------------------------------------
# Uso local: copiar este archivo a ".env"  (cp .env.example .env)
# Producción (Render): configurar en Render → Environment → Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos (agnóstica al motor)
# -----------------------------------------------------------------------------
# SQLite (desarrollo local, por defecto):
DATABASE_URL=sqlite:///./sistema_it.db

# MySQL (producción) — requiere descomentar "pymysql" en requirements.txt:
# DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/sistema_it

# PostgreSQL (producción RECOMENDADA) — requiere descomentar "psycopg2-binary":
# DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/sistema_it
#
# ⚠️  En Render el disco es efímero: NO usar SQLite en producción
#     (los datos se perderían en cada redeploy/reinicio).

# -----------------------------------------------------------------------------
# URLs de despliegue
# -----------------------------------------------------------------------------
# URL pública del frontend (Vercel).
FRONTEND_URL=https://sistema-it-alianza-francesa.vercel.app

# URL pública del portal (usada en los enlaces de los correos).
APP_URL=https://sistema-it-alianza-francesa.vercel.app

# URL pública del backend (Render).
BACKEND_URL=https://<tu-servicio>.onrender.com

# Orígenes permitidos por CORS (separados por coma).
# Solo se aceptan los orígenes enumerados aquí y FRONTEND_URL.
CORS_ORIGINS=http://localhost:3000,https://sistema-it-alianza-francesa.vercel.app

# Entorno de ejecución.
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Dominio corporativo permitido para el auto-registro / login.
ALLOWED_EMAIL_DOMAIN=@alianzafrancesa.org.pe

# Audiencia OAuth. Debe ser idéntica a NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
GOOGLE_CLIENT_ID=274739568755-s1kq1q8orh7e3edneubiahgimtrgvrgi.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# SMTP (correo saliente) — completar para habilitar notificaciones reales
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=soporte-ti@alianzafrancesa.org.pe
SMTP_USE_TLS=true

# -----------------------------------------------------------------------------
# WhatsApp (alertas automáticas de nuevos tickets) — opcional
# -----------------------------------------------------------------------------
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TECH_PHONE=+51986068159

# -----------------------------------------------------------------------------
# IA / Asistente virtual (DeepSeek) — opcional
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

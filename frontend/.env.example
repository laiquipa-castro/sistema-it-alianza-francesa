# =============================================================================
# Configuración del FRONTEND (Next.js)
# -----------------------------------------------------------------------------
# Uso local: copiar este archivo a ".env.local"  (cp .env.example .env.local)
# Producción (Vercel): configurar en Vercel → Settings → Environment Variables
# =============================================================================

# URL base del backend (API FastAPI).
#   - Desarrollo local : http://127.0.0.1:8000
#   - Producción (Render): https://<tu-servicio>.onrender.com
#
# IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan en el build de Next.js,
# por lo que cualquier cambio requiere un nuevo deploy (redeploy) en Vercel.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ID público de la aplicación web registrado en Google Cloud OAuth.
# Debe coincidir con GOOGLE_CLIENT_ID en el backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=274739568755-s1kq1q8orh7e3edneubiahgimtrgvrgi.apps.googleusercontent.com

# URL pública del frontend (informativa; actualmente no se consume en el código).
NEXT_PUBLIC_APP_URL=http://localhost:3000
